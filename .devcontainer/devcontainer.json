{
    "name": "My Codespace",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/zsh"
            },
            "extensions": [
                "ms-vscode-remote.remote-containers",
                "ms-vscode.makefile-tools",
                "ms-python.python",
                "tamasfe.even-better-toml",
                "mhutchie.git-graph",
                "nefrob.vscode-just-syntax"
            ]
        }
    },
    "remoteEnv": {
        "GIT_EDITOR": "vim"
    }
}